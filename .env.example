# =============================================================================
# Rails API (dermetics_api/) — copy to `.env` for local dev
# =============================================================================
# Kamal/Docker: set in config/deploy.yml env.secret / env.clear (never commit real values).
#
# Public URL(s) of the Next.js app (comma-separated). Required for CORS + credentialed cookies.
FRONTEND_ORIGIN=http://localhost:3000
# Production examples:
# FRONTEND_ORIGIN=https://yourdomain.com
# FRONTEND_ORIGIN=https://app.yourdomain.com,https://www.yourdomain.com

# Must match JWT_SECRET on the Next.js app exactly.
JWT_SECRET=dev-secret-change-me

# Only when UI and API are on different subdomains of the same registrable domain
# (e.g. app.example.com + api.example.com). Omit for localhost or single-host deploy.
# COOKIE_DOMAIN=.yourdomain.com

# HTTP port (Puma). Docker/Kamal usually sets PORT=80 inside the container.
PORT=3001

# Rails environment
RAILS_ENV=development

# Production only — decrypt credentials; copy from config/master.key (do not commit).
# RAILS_MASTER_KEY=

# Optional logging
# RAILS_LOG_LEVEL=info

# MaxMind GeoLite2-City (https://dev.maxmind.com/geoip/geolite2-free-geolocation-data)
# Download GeoLite2-City.mmdb into vendor/geoip/ (gitignored).
GEOIP_DATABASE_PATH=vendor/geoip/GeoLite2-City.mmdb

# Local only: pretend all API requests come from this public IP (test India/Bangalore geo).
# Example Bengaluru in GeoLite2: 117.192.0.1 — restart Rails after changing.
# DEV_SIMULATE_CLIENT_IP=117.192.0.1

# Used by `bin/rails db:seed` (change before first production seed)
ADMIN_EMAIL=admin@dermatics.com
ADMIN_PASSWORD=admin123
