# =============================================================================
# Rails API (dermetics_api/) — copy to `.env` for local dev
# =============================================================================
# Kamal/Docker: set in config/deploy.yml env.secret / env.clear (never commit real values).
#
# Public URL(s) of the Frontend app (comma-separated). Required for CORS + credentialed cookies.
FRONTEND_ORIGIN=http://localhost:3000

# Production Examples:
# Strategy A (Same Domain / Reverse Proxy - Recommended):
#   FRONTEND_ORIGIN=https://dermatics.com
#   COOKIE_DOMAIN=
#   COOKIE_SAME_SITE=lax
#
# Strategy B (Subdomain setup):
#   FRONTEND_ORIGIN=https://app.dermatics.com,https://dermatics.com
#   COOKIE_DOMAIN=.dermatics.com
#   COOKIE_SAME_SITE=lax
#
# Strategy C (Separate root domains e.g. Vercel + Render - subject to Safari/Chrome 3rd-party cookie blocks):
#   FRONTEND_ORIGIN=https://my-app.vercel.app
#   COOKIE_DOMAIN=
#   COOKIE_SAME_SITE=none
#   COOKIE_SECURE=true

# Secret used to sign JWT auth cookies. Must be >= 32 characters in production.
JWT_SECRET=dev-secret-change-me

# Cookie Domain (leave empty for same domain; set e.g. .dermatics.com for cross-subdomain)
# COOKIE_DOMAIN=

# Cookie SameSite (:lax by default; use :none only for cross-site domains)
# COOKIE_SAME_SITE=lax

# Cookie Secure (true by default in production; set to false only if testing non-HTTPS staging)
# COOKIE_SECURE=true

# HTTP port (Puma). Docker/Kamal usually sets PORT=80 inside the container.
PORT=3001

# Rails environment
RAILS_ENV=development

# Production only — decrypt credentials; copy from config/master.key (do not commit).
# RAILS_MASTER_KEY=

# Optional logging
# RAILS_LOG_LEVEL=info

# Used by `bin/rails db:seed` (change before first production seed)
ADMIN_EMAIL=admin@dermatics.com
ADMIN_PASSWORD=admin123

# Commerce: test marks COD/online orders paid immediately; live keeps online orders pending (Razorpay stub).
PAYMENT_MODE=test
